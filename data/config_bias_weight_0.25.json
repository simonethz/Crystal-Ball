{
    "analysis": {
        "dataset": "Crystal_Ball"
    },
    "solver": {
        "name": "gurobi",
        "solver_options": {
            "Method": 2,
            "NodeMethod": 2,
            "BarHomogeneous": 1,
            "DualReductions": 0,
            "Threads": 128,
            "Crossover": 0,
            "ScaleFlag": 2,
            "BarOrder": 0
        },
        "save_duals": true,
        "use_scaling": false,
        "run_diagnostics": true,
        "scaling_include_rhs": true
    },
    "plugins": {
        "investment_decisions": {
            "profitability_bias_enabled": true,
            "bias_weight": 0.25,
            "bias_output_carriers": [
                "electricity"
            ]
        }
    }
}